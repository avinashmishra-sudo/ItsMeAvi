# =============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# =============================================================================
# Rename this file to .env.local for local development.
# In production, configure these variables in the Vercel Project Settings.

# -----------------------------------------------------------------------------
# 1. Supabase Configuration (Client & Public)
# -----------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
# NEXT_PUBLIC_ variables are exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# -----------------------------------------------------------------------------
# 2. Supabase Service Role Key (SERVER ONLY - NEVER EXPOSE TO BROWSER)
# -----------------------------------------------------------------------------
# Used for administrative server-side operations, storage bucket initialization,
# and bypassing RLS when creating initial admin or running background sync tasks.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# -----------------------------------------------------------------------------
# 3. YouTube Data API v3 (SERVER ONLY)
# -----------------------------------------------------------------------------
# Used to automatically fetch recent uploads from https://www.youtube.com/@TheEyesChicko
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> Create API Key
# Enable "YouTube Data API v3" in API Library.
YOUTUBE_API_KEY=your-google-youtube-data-api-v3-key

# -----------------------------------------------------------------------------
# 4. Vercel Cron Secret (SERVER ONLY)
# -----------------------------------------------------------------------------
# Secret token used to protect /api/cron/sync-youtube against unauthorized triggers.
# Must match the Authorization: Bearer <token> sent by Vercel Cron or your trigger script.
CRON_SECRET=your-random-secure-cron-secret-string-at-least-32-chars

# -----------------------------------------------------------------------------
# 5. Site URL (Canonical and SEO)
# -----------------------------------------------------------------------------
# Used for Open Graph tags, sitemaps, and canonical links.
# In local development: http://localhost:3000
# In production: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
